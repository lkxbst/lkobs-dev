---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { getPortfolioData } from '../lib/api';

const data = await getPortfolioData();
const { profile, socialLinks, experiences, projects } = data;
const pageTitle = `${profile.name} — ${profile.handle}`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://luankobs.dev';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: siteUrl,
  jobTitle: 'Desenvolvedor de Software',
  email: profile.email,
  sameAs: socialLinks.map((link) => link.url),
};
---

<BaseLayout title={pageTitle} description={profile.headline} jsonLd={jsonLd}>
  <Header handle={profile.handle} />
  <main id="conteudo-principal" class="flex-1">
    <Hero profile={profile} socialLinks={socialLinks} />
    <About profile={profile} />
    <Experience experiences={experiences} profile={profile} />
    <Projects projects={projects} socialLinks={socialLinks} />
    <Contact profile={profile} socialLinks={socialLinks} />
  </main>
  <Footer name={profile.name} />
</BaseLayout>
