---
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import ExternalLink from './ExternalLink.astro';
import type { Project } from '../lib/schema';

interface Props {
  project: Project;
  isFirst?: boolean;
}

const { project, isFirst = false } = Astro.props;
---

<article
  class:list={[
    'grid grid-cols-1 items-start gap-6 sm:grid-cols-[387px_1fr] sm:gap-[38px]',
    isFirst ? 'pb-14' : 'py-14',
  ]}
>
  <div class="order-2 flex flex-col sm:order-1">
    <p class="font-mono text-[12px] text-fg-muted">
      {project.number} · [{project.year}]
    </p>

    <h3 class="mt-3 text-[22px] leading-snug font-medium text-fg">
      {project.name}
    </h3>

    <p class="mt-3 text-[15px] leading-[1.6] text-fg-muted">
      {project.description}
    </p>

    {
      project.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologias utilizadas">
          {project.tags.map((tag) => (
            <li>
              <Tag label={tag} />
            </li>
          ))}
        </ul>
      )
    }

    {
      (project.liveUrl || project.repoUrl) && (
        <div class="mt-6 flex flex-wrap items-center gap-6 text-[14px]">
          {project.liveUrl && <ExternalLink href={project.liveUrl}>Ver projeto</ExternalLink>}
          {project.repoUrl && <ExternalLink href={project.repoUrl}>Código</ExternalLink>}
        </div>
      )
    }
  </div>

  <div class="order-1 sm:order-2">
    <div
      class="aspect-[16/10] w-full overflow-hidden rounded-[6px] border border-border bg-surface"
    >
      {
        project.image ? (
          <Image
            src={project.image.url}
            alt={project.image.alt}
            width={project.image.width}
            height={project.image.height}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        ) : (
          <div class="project-placeholder-stripes flex h-full w-full items-center justify-center p-4">
            <span class="font-mono text-[12px] text-fg-muted">captura de tela do projeto</span>
          </div>
        )
      }
    </div>
  </div>
</article>
