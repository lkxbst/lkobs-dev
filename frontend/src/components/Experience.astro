---
import SectionLabel from './SectionLabel.astro';
import ExternalLink from './ExternalLink.astro';
import { formatExperiencePeriod } from '../lib/format';
import type { Experience as ExperienceItem, Profile } from '../lib/schema';

interface Props {
  experiences: ExperienceItem[];
  profile: Profile;
}

const { experiences, profile } = Astro.props;
const resumeHref = profile.resumeUrl ?? '/cv';
---

<section
  id="experiencia"
  aria-labelledby="heading-experiencia"
  class="scroll-mt-20 border-t border-border py-16 lg:py-20"
>
  <div class="container-portfolio grid grid-cols-1 gap-8 lg:grid-cols-[208px_1fr] lg:gap-0">
    <div>
      <SectionLabel id="heading-experiencia" label="Experiência" />
    </div>

    <div>
      <div class="divide-y divide-border">
        {
          experiences.map((exp, index) => (
            <article
              class:list={[
                'grid grid-cols-1 gap-2 sm:grid-cols-[168px_1fr] sm:gap-0',
                index === 0 ? 'pb-8' : 'py-8',
              ]}
            >
              <div class="font-mono text-[13px] leading-[1.6] text-fg-muted">
                [{formatExperiencePeriod(exp.startYear, exp.endYear)}]
              </div>

              <div>
                <h3 class="text-[17px] leading-snug font-medium text-fg">
                  {exp.role} <span class="font-normal text-fg-muted">· {exp.company}</span>
                </h3>
                <p class="mt-2 text-[15px] leading-[1.6] text-fg-muted">{exp.impact}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-6 border-t border-border pt-8 text-[14px]">
        <ExternalLink href={resumeHref}>Currículo completo (PDF)</ExternalLink>
      </div>
    </div>
  </div>
</section>
