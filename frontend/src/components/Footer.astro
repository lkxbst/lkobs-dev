---
interface Props {
  name: string;
}

const { name } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border py-8">
  <div
    class="container-portfolio flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
  >
    <p class="font-mono text-[12px] text-fg-muted">
      © {currentYear}
      {name}
    </p>

    <a
      href="#topo"
      class="font-mono text-[12px] text-fg-muted transition-colors duration-150 hover:text-fg"
    >
      Voltar ao topo <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>
