---
import SectionGrid from './SectionGrid.astro';
import { getUiStrings, isFilledText, type Locale } from '../lib/i18n';
import type { Profile } from '../lib/schema';

interface Props {
  profile: Profile;
  locale?: Locale;
}

const { profile, locale = 'pt' } = Astro.props;
const ui = getUiStrings(locale);

const hasPrimary = isFilledText(profile.about.primary);
const hasSecondary = isFilledText(profile.about.secondary);
const tools = profile.tools.filter((tool) => isFilledText(tool));
const hasContent = hasPrimary || hasSecondary || tools.length > 0;
---

{
  hasContent && (
    <SectionGrid id="sobre" headingId="heading-sobre" label={ui.about.label}>
      <div class="max-w-[700px]">
        {hasPrimary && <p class="text-[18px] leading-[1.6] text-fg">{profile.about.primary}</p>}

        {hasSecondary && (
          <p class:list={['text-[18px] leading-[1.6] text-fg-muted', hasPrimary && 'mt-6']}>
            {profile.about.secondary}
          </p>
        )}

        {tools.length > 0 && (
          <div class="mt-10 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-baseline sm:gap-8">
            <span class="font-mono text-[12px] text-fg-muted">{ui.about.toolsLabel}</span>
            <p class="font-mono text-[13px] leading-relaxed text-fg">{tools.join(' · ')}</p>
          </div>
        )}
      </div>
    </SectionGrid>
  )
}
