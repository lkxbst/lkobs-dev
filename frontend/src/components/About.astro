---
import SectionLabel from './SectionLabel.astro';
import type { Profile } from '../lib/schema';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section
  id="sobre"
  aria-labelledby="heading-sobre"
  class="scroll-mt-20 border-t border-border py-16 lg:py-20"
>
  <div class="container-portfolio grid grid-cols-1 gap-8 lg:grid-cols-[420px_1fr] lg:gap-0">
    <div>
      <SectionLabel id="heading-sobre" label="Sobre" />
    </div>

    <div>
      <p class="text-[18px] leading-[1.6] text-fg">
        {profile.about.primary}
      </p>

      <p class="mt-6 text-[18px] leading-[1.6] text-fg-muted">
        {profile.about.secondary}
      </p>

      <div
        class="mt-10 flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-baseline sm:gap-8"
      >
        <span class="font-mono text-[12px] text-fg-muted">Ferramentas</span>
        <p class="font-mono text-[13px] leading-relaxed text-fg">
          {profile.tools.join(' · ')}
        </p>
      </div>
    </div>
  </div>
</section>
