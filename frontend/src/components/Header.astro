---
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import { getUiStrings, LOCALES, type Locale } from '../lib/i18n';

interface Props {
  handle: string;
  locale?: Locale;
}

const { handle, locale = 'pt' } = Astro.props;
const ui = getUiStrings(locale);

const navItems = [
  { label: ui.nav.about, href: '#sobre' },
  { label: ui.nav.experience, href: '#experiencia' },
  { label: ui.nav.projects, href: '#projetos' },
  { label: ui.nav.contact, href: '#contato' },
];
---

<header id="topo" class="sticky top-0 z-40 h-20 border-b border-border bg-bg/95 backdrop-blur-xs">
  <div class="container-portfolio flex h-full items-center justify-between">
    <a
      href="#topo"
      class="font-mono text-[14px] font-medium tracking-tight text-fg transition-opacity duration-150 hover:opacity-80"
    >
      {handle}
    </a>

    <div class="flex items-center gap-5 sm:gap-6">
      <nav aria-label={ui.navAriaLabel} class="hidden sm:block">
        <ul class="flex items-center gap-7">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link={item.href.slice(1)}
                  class="text-[14px] text-fg-muted transition-colors duration-150 hover:text-fg data-[active=true]:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        aria-label={ui.langSwitcherAriaLabel}
        data-lang-switcher
        class="hidden items-center gap-1.5 font-mono text-[12px] sm:flex"
      >
        {
          LOCALES.map((loc, idx) => (
            <>
              {idx > 0 && (
                <span aria-hidden="true" class="text-fg-subtle">
                  ·
                </span>
              )}
              <a
                href={loc.href}
                aria-current={loc.code === locale ? 'page' : undefined}
                class:list={[
                  'px-1 py-0.5 transition-colors duration-150',
                  loc.code === locale
                    ? 'font-medium text-fg underline decoration-accent decoration-2 underline-offset-4'
                    : 'text-fg-muted hover:text-fg',
                ]}
              >
                {loc.label}
              </a>
            </>
          ))
        }
      </nav>

      <MobileMenu items={navItems} locale={locale} />
      <ThemeToggle />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('main section[id]');
    const navLinks = document.querySelectorAll('[data-nav-link]');
    if (!sections.length || !navLinks.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const active = link.getAttribute('data-nav-link') === id;
              link.setAttribute('data-active', active ? 'true' : 'false');
            });
          }
        });
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>
