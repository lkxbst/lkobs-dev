---
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import LanguageDropdown from './LanguageDropdown.astro';
import { getUiStrings, type Locale } from '../lib/i18n';

interface Props {
  handle: string;
  locale?: Locale;
  showAbout?: boolean;
  showExperience?: boolean;
  showProjects?: boolean;
  showContact?: boolean;
}

const {
  handle,
  locale = 'pt',
  showAbout = true,
  showExperience = true,
  showProjects = true,
  showContact = true,
} = Astro.props;

const ui = getUiStrings(locale);

const navItems = [
  ...(showAbout ? [{ label: ui.nav.about, href: '#sobre' }] : []),
  ...(showExperience ? [{ label: ui.nav.experience, href: '#experiencia' }] : []),
  ...(showProjects ? [{ label: ui.nav.projects, href: '#projetos' }] : []),
  ...(showContact ? [{ label: ui.nav.contact, href: '#contato' }] : []),
];
---

<header id="topo" class="sticky top-0 z-40 h-20 border-b border-border bg-bg/95 backdrop-blur-xs">
  <div class="container-portfolio flex h-full items-center justify-between">
    <a
      href="#topo"
      class="inline-flex min-h-11 items-center font-mono text-[14px] font-medium tracking-tight text-fg transition-opacity duration-150 hover:opacity-80 sm:min-h-8"
    >
      {handle}
    </a>

    <div class="flex items-center">
      <nav aria-label={ui.navAriaLabel} class="hidden sm:block" data-header-nav>
        <ul class="flex items-center gap-7">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link={item.href.slice(1)}
                  class="inline-flex min-h-8 items-center text-[14px] text-fg-muted transition-colors duration-150 hover:text-fg data-[active=true]:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <span
        aria-hidden="true"
        data-header-divider
        class="mx-[18px] hidden h-4 w-px bg-border sm:block"></span>

      <div class="flex items-center gap-3" data-header-preferences>
        <LanguageDropdown locale={locale} />
        <MobileMenu items={navItems} locale={locale} />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('main section[id]');
    const navLinks = document.querySelectorAll('[data-nav-link]');
    if (!sections.length || !navLinks.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const active = link.getAttribute('data-nav-link') === id;
              link.setAttribute('data-active', active ? 'true' : 'false');
            });
          }
        });
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>
