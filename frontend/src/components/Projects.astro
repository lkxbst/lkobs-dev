---
import SectionGrid from './SectionGrid.astro';
import ProjectCard from './ProjectCard.astro';
import ExternalLink from './ExternalLink.astro';
import { getUiStrings, isFilledText, type Locale } from '../lib/i18n';
import type { Project, SocialLink } from '../lib/schema';

interface Props {
  projects: Project[];
  socialLinks: SocialLink[];
  locale?: Locale;
}

const { projects, socialLinks, locale = 'pt' } = Astro.props;
const ui = getUiStrings(locale);
const validProjects = projects.filter(
  (proj) => isFilledText(proj.name) && isFilledText(proj.description),
);
const githubLink =
  socialLinks.find((link) => link.label.toLowerCase().includes('github'))?.url ??
  'https://github.com/lkxbst';
---

{
  validProjects.length > 0 && (
    <SectionGrid id="projetos" headingId="heading-projetos" label={ui.projects.label}>
      <div class="divide-y divide-border">
        {validProjects.map((project, index) => (
          <ProjectCard project={project} isFirst={index === 0} locale={locale} />
        ))}
      </div>

      <div class="mt-2 border-t border-border pt-8 text-[14px]">
        <ExternalLink href={githubLink}>{ui.projects.moreOnGithub}</ExternalLink>
      </div>
    </SectionGrid>
  )
}
