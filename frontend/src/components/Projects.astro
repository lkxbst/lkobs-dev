---
import SectionLabel from './SectionLabel.astro';
import ProjectCard from './ProjectCard.astro';
import ExternalLink from './ExternalLink.astro';
import { getUiStrings, type Locale } from '../lib/i18n';
import type { Project, SocialLink } from '../lib/schema';

interface Props {
  projects: Project[];
  socialLinks: SocialLink[];
  locale?: Locale;
}

const { projects, socialLinks, locale = 'pt' } = Astro.props;
const ui = getUiStrings(locale);
const githubLink =
  socialLinks.find((link) => link.label.toLowerCase().includes('github'))?.url ??
  'https://github.com/lkxbst';
---

<section
  id="projetos"
  aria-labelledby="heading-projetos"
  class="scroll-mt-20 border-t border-border py-16 lg:py-20"
>
  <div class="container-portfolio grid grid-cols-1 gap-8 lg:grid-cols-[208px_1fr] lg:gap-0">
    <div>
      <SectionLabel id="heading-projetos" label={ui.projects.label} />
    </div>

    <div>
      <div class="divide-y divide-border">
        {
          projects.map((project, index) => (
            <ProjectCard project={project} isFirst={index === 0} locale={locale} />
          ))
        }
      </div>

      <div class="mt-2 border-t border-border pt-8 text-[14px]">
        <ExternalLink href={githubLink}>{ui.projects.moreOnGithub}</ExternalLink>
      </div>
    </div>
  </div>
</section>
